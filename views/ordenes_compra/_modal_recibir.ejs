<div class="modal fade" id="recibirOrdenModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-box-arrow-in-down me-2"></i>Recibir Orden <span id="recibirOrdenTitulo"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">
                    Ajusta la cantidad si lo que llegó no coincide con lo pedido; el inventario se actualiza con lo
                    que escribas aquí, no con lo pedido.
                </p>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Insumo</th>
                                <th class="text-end">Pedido</th>
                                <th class="text-end" style="width: 140px">Recibido</th>
                            </tr>
                        </thead>
                        <tbody id="recibirLineasTbody"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success" id="btnConfirmarRecibir">
                    <i class="bi bi-check-lg me-1"></i>Confirmar Recepción
                </button>
            </div>
        </div>
    </div>
</div>
