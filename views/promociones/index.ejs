<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Promociones - <%= tenant.nombre %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>

<body class="bg-light">
    <%- include('../partials/navbar', { user: user, tenant: tenant }) %>

    <div class="container py-4">
        <div class="row mb-4">
            <div class="col-md-8">
                <h2 class="fw-bold"><i class="bi bi-percent me-2 text-primary"></i>Promociones</h2>
                <p class="text-muted">
                    Descuentos automáticos por día y/o franja horaria, sobre productos puntuales, una categoría
                    completa, o todo el catálogo (si no le asignás productos ni categorías). Se aplican solos, sin
                    que el mesero tenga que activarlos, y se ven en Mesas, POS, el Menú QR y la factura final.
                </p>
            </div>
            <div class="col-md-4 text-md-end">
                <button class="btn btn-primary" id="btnNuevaPromocion">
                    <i class="bi bi-plus-lg me-1"></i>Nueva promoción
                </button>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white"><strong>Promociones configuradas</strong></div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Nombre</th>
                                <th>Descuento</th>
                                <th>Activación</th>
                                <th>Días</th>
                                <th>Horario</th>
                                <th>Alcance</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="promocionesTbody">
                            <% if (promociones.length === 0) { %>
                                <tr><td colspan="8" class="text-center text-muted py-4">Todavía no has creado ninguna promoción.</td></tr>
                            <% } %>
                            <% promociones.forEach(function (p) { %>
                                <tr data-id="<%= p.id %>">
                                    <td class="fw-medium"><%= p.nombre %></td>
                                    <td><%= p.valor_tipo === 'porcentaje' ? Number(p.valor) + '%' : '$' + Number(p.valor).toLocaleString('es-CO') %></td>
                                    <td>
                                        <% if (Number(p.cantidad_minima) > 1) { %>
                                            <span class="badge bg-info-subtle text-info-emphasis">Desde <%= p.cantidad_minima %> unid.</span>
                                        <% } else { %>
                                            <span class="text-muted small">Por venta</span>
                                        <% } %>
                                    </td>
                                    <td><%= p.dias_semana ? p.dias_semana.split(',').join(', ') : 'Todos' %></td>
                                    <td><%= (p.hora_inicio && p.hora_fin) ? p.hora_inicio.slice(0,5) + ' - ' + p.hora_fin.slice(0,5) : 'Todo el día' %></td>
                                    <td class="text-muted small">
                                        <% if (Number(p.productos_count) === 0 && Number(p.categorias_count) === 0) { %>
                                            Todo el catálogo
                                        <% } else { %>
                                            <% const partes = []; %>
                                            <% if (Number(p.productos_count) > 0) partes.push(p.productos_count + ' producto' + (p.productos_count == 1 ? '' : 's')); %>
                                            <% if (Number(p.categorias_count) > 0) partes.push(p.categorias_count + ' categoría' + (p.categorias_count == 1 ? '' : 's')); %>
                                            <%= partes.join(' · ') %>
                                        <% } %>
                                    </td>
                                    <td>
                                        <span class="badge bg-<%= p.activa ? 'success' : 'secondary' %>"><%= p.activa ? 'Activa' : 'Inactiva' %></span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary btn-editar-promocion" title="Editar"><i class="bi bi-pencil"></i></button>
                                        <button class="btn btn-sm btn-outline-danger btn-borrar-promocion" title="Eliminar"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Crear/Editar Promoción -->
    <div class="modal fade" id="modalPromocion" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalPromocionTitulo">Nueva promoción</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="promocionId">
                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input type="text" id="promoNombre" class="form-control" placeholder="Ej. Martes de pizza">
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label">Tipo de descuento</label>
                            <select id="promoValorTipo" class="form-select">
                                <option value="porcentaje">Porcentaje (%)</option>
                                <option value="valor">Valor fijo ($)</option>
                            </select>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Valor</label>
                            <input type="number" id="promoValor" class="form-control" min="1" step="1" placeholder="Ej. 20">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label d-block">¿Cómo se activa?</label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="promoActivacion" id="activacionVenta" value="venta" checked>
                            <label class="form-check-label" for="activacionVenta">Por la venta del producto (siempre que se venda)</label>
                        </div>
                        <div class="form-check d-flex align-items-center gap-2">
                            <input class="form-check-input" type="radio" name="promoActivacion" id="activacionCantidad" value="cantidad">
                            <label class="form-check-label" for="activacionCantidad">Solo si compran</label>
                            <input type="number" id="promoCantidadMinima" class="form-control form-control-sm" style="width: 70px" min="2" step="1" value="2" disabled>
                            <label class="form-check-label" for="promoCantidadMinima">o más unidades del mismo producto</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label d-block">Días de la semana <span class="text-muted small">(ninguno marcado = todos los días)</span></label>
                        <div class="d-flex flex-wrap gap-3">
                            <% const diasLabel = { lun: 'Lun', mar: 'Mar', mie: 'Mié', jue: 'Jue', vie: 'Vie', sab: 'Sáb', dom: 'Dom' }; %>
                            <% Object.keys(diasLabel).forEach(function (d) { %>
                                <div class="form-check">
                                    <input class="form-check-input promo-dia" type="checkbox" value="<%= d %>" id="dia-<%= d %>">
                                    <label class="form-check-label" for="dia-<%= d %>"><%= diasLabel[d] %></label>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label">Hora inicio <span class="text-muted small">(vacío = todo el día)</span></label>
                            <input type="time" id="promoHoraInicio" class="form-control">
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Hora fin</label>
                            <input type="time" id="promoHoraFin" class="form-control">
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label">Vigente desde <span class="text-muted small">(opcional)</span></label>
                            <input type="date" id="promoFechaInicio" class="form-control">
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Vigente hasta <span class="text-muted small">(opcional)</span></label>
                            <input type="date" id="promoFechaFin" class="form-control">
                        </div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label">Productos específicos <span class="text-muted small">(ninguno = todos)</span></label>
                            <select id="promoProductos" class="form-select" multiple size="6">
                                <% productos.forEach(function (p) { %>
                                    <option value="<%= p.id %>"><%= p.nombre %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Categorías específicas <span class="text-muted small">(ninguna = todas)</span></label>
                            <select id="promoCategorias" class="form-select" multiple size="6">
                                <% categorias.forEach(function (c) { %>
                                    <option value="<%= c.id %>"><%= c.nombre %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="promoActiva" checked>
                        <label class="form-check-label" for="promoActiva">Activa</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" id="btnGuardarPromocion">Guardar</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/modulos/promociones.js"></script>
</body>

</html>
