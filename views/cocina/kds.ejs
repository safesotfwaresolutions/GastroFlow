<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KDS por Estación</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/modulos/kds.css">
</head>

<body>
    <%- include('../partials/navbar', { user: typeof user !=='undefined' ? user : null, tenant: typeof tenant
        !=='undefined' ? tenant : null }) %>

        <div class="container-fluid px-3">
            <div class="d-flex justify-content-between align-items-center mb-3 mt-2">
                <h4 class="mb-0"><i class="bi bi-columns-gap me-2"></i>KDS por Estación</h4>
                <div>
                    <a href="/cocina" class="btn btn-outline-secondary btn-sm me-2">
                        <i class="bi bi-table me-1"></i>Ver por mesa
                    </a>
                    <a href="/estaciones" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-gear me-1"></i>Editar estaciones
                    </a>
                </div>
            </div>

            <div id="kdsColumnas" class="kds-columnas"></div>
        </div>

        <!-- Data island: estaciones activas del tenant, ya ordenadas -->
        <script type="application/json" id="kds-estaciones-data"><%- JSON.stringify(estaciones) %></script>

        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script src="/js/modulos/cocina_kds.js"></script>
</body>

</html>
