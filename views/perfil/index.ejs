<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perfil del Negocio</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>

<body class="bg-light">
    <%- include('../partials/navbar', { user: user, tenant: tenant }) %>

        <div class="container mt-4 mb-5">
            <h2 class="mb-4"><i class="bi bi-shop me-2"></i>Perfil del Negocio</h2>

            <ul class="nav nav-tabs mb-4" id="perfilTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="perfil-tab" data-bs-toggle="tab" data-bs-target="#perfil"
                        type="button" role="tab">
                        <i class="bi bi-shop me-1"></i>Perfil
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="crecimiento-tab" data-bs-toggle="tab" data-bs-target="#crecimiento"
                        type="button" role="tab">
                        <i class="bi bi-graph-up-arrow me-1"></i>Crecimiento
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="perfilTabContent">
                <div class="tab-pane fade show active" id="perfil" role="tabpanel" aria-labelledby="perfil-tab">
                    <div class="row g-4">
                        <%- include('_resumen') %>
                            <%- include('_config_form') %>
                    </div>
                </div>
                <%- include('_tab_crecimiento') %>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
        <script src="/js/modulos/perfil.js"></script>
        <script src="/js/modulos/perfil-crecimiento.js"></script>
</body>

</html>